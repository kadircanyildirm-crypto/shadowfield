meta:
  id: shadowfield_43784_raw_len97
  title: "NORAD 43784 raw:len97 (draft, generated by Shadowfield)"
doc: |
  Generated blind from raw SatNOGS frames by Shadowfield: field positions from orbital
  physics (sunlight, shadow, orbit, IGRF, GNSS), names and units proposed by Claude.
  Review before use. Bit-level flags and fields with no physical driver stay unknown.
seq:
  - id: unknown_0
    size: 29
  - id: uptime_or_tick_counter
    type: u4be
    doc: "counter, ticks, raw * 1; evidence: counter (score 1.00)"
  - id: unknown_33
    size: 1
  - id: gnss_pos_ecef_x
    type: s4be
    doc: "navigation, m, raw / 100000 * 1000 (raw_per_km ~1e5, i.e. 10 cm units); evidence: position (score 1.00)"
  - id: gnss_pos_ecef_y
    type: s4be
    doc: "navigation, m, raw / 100 (cm to m); evidence: position (score 1.00)"
  - id: gnss_pos_eci_z
    type: s4be
    doc: "navigation, m, raw / 100 (cm to m); evidence: position (score 1.00)"
  - id: unknown_46
    size: 1
  - id: gnss_vel_ecef_x
    type: b24be
    doc: "navigation, m/s, raw / 100; evidence: position (score 1.00) (signed 24-bit on the satellite; read here as unsigned)"
  - id: unknown_50
    size: 1
  - id: gnss_vel_ecef_y
    type: s4be
    doc: "navigation, m/s, raw / 100 (tentative); evidence: position (score 1.00)"
  - id: gnss_vel_eci_z
    type: b24be
    doc: "navigation, m/s, raw / 100; evidence: position (score 1.00) (signed 24-bit on the satellite; read here as unsigned)"
  - id: unknown_58
