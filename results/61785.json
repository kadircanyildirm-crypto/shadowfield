  "names": {
   "summary": "A 72-byte housekeeping/telemetry beacon (first byte 0x84) with a Unix timestamp, a solar-array current, battery or bus voltages, four temperatures that move together, and a one-byte rolling sequence counter. All frames are in sunlight, but an eclipse occurred in the previous 80 minutes, so the lagged correlations are still meaningful.",
   "fields": [
    {
     "offset": 17,
     "name": "unix_timestamp",
     "category": "clock",
     "unit": "s",
     "scale": "raw",
     "confidence": 0.95,
     "rationale": "u4le ticking at 1.00 s/s with no resets, and the values match the Unix epoch (about 1.79e9). The small epoch offset of 20 s is likely a latency or packing delay."
    },
    {
     "offset": 25,
     "name": "solar_array_current",
     "category": "power_solar",
     "unit": "mA",
     "scale": "raw * 1.0",
     "confidence": 0.7,
     "rationale": "Reads exactly 0 in shadow and about 200 (p95 332) in sun. rho_sun is 0.93 with no trend inside each regime, so it is set directly by illumination. The unit and scale are guesses."
    },
    {
     "offset": 27,
     "name": "battery_cell_voltage",
     "category": "power_battery",
     "unit": "mV",
     "scale": "raw * 1.0",
     "confidence": 0.6,
     "rationale": "Range 4020-4141 is typical of a single Li-ion cell in mV. It is narrow (spread 0.013), higher in sun, with shadow/sun ratio 0.994. It moves with offsets 29 and 57, which are about twice its value, so they look like the two-cell stack."
    },
    {
     "offset": 29,
     "name": "battery_pack_voltage",
     "category": "power_battery",
     "unit": "mV",
